# Dockerfile para frontend en Render con Nginx.
# Usa PORT y BACKEND_HOSTPORT de Render para generar la configuración en tiempo de arranque.

FROM nginx:1.27-alpine

RUN apk add --no-cache gettext

COPY nginx.render.template.conf /etc/nginx/templates/default.conf.template
COPY . /usr/share/nginx/html

ENV PORT=10000

EXPOSE 10000

CMD ["/bin/sh", "-c", "envsubst '$$PORT $$BACKEND_HOSTPORT' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]

# Global ISO Security - entorno local con Docker Compose
# Copie este archivo como .env y reemplace TODOS los valores CAMBIAR_*.

MYSQL_DATABASE=globalisosecurity
MYSQL_ROOT_PASSWORD=CAMBIAR_POR_UN_SECRETO_DE_BASE_DE_DATOS
MYSQL_PORT=3307

# JWT: cadena aleatoria, privada y de al menos 32 caracteres.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_JWT_ALEATORIO_DE_32_O_MAS_CARACTERES
JWT_EXPIRATION=3600000

FRONTEND_PORT=8080

# Semillas desactivadas por defecto; activar solo en un entorno controlado.
SEED_ENABLED=false
SEED_DEMO_DATA=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# ML: use el mismo valor aleatorio de al menos 32 caracteres en ambos lados.
ML_API_KEY=CAMBIAR_POR_UN_SECRETO_ML_ALEATORIO_DE_32_O_MAS_CARACTERES
RPM_ML_API_KEY=CAMBIAR_POR_EL_MISMO_SECRETO_ML_DE_ARRIBA
RPM_ML_ENABLED=true
RPM_ML_URL=http://ml-service:8002
RPM_ML_TIMEOUT_SECONDS=120

# Controles de autenticación.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BLOCK_MINUTES=15
LOGIN_MAX_TRACKED_KEYS=10000
PASSWORD_MIN_LENGTH=15
MFA_ENCRYPTION_KEY=CAMBIAR_POR_BASE64_DE_32_BYTES_GENERADOS_ALEATORIAMENTE
DB_MIGRATIONS_ENABLED=false

# Dentro de Docker se fuerza /app/storage/evidencias y se monta un volumen persistente.
# Para ejecución local directa puede usar una ruta absoluta o relativa:
EVIDENCE_STORAGE_PATH=./storage/evidencias

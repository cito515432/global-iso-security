# Global ISO Security - entorno local con Docker Compose
MYSQL_DATABASE=globalisosecurity
MYSQL_ROOT_PASSWORD=CAMBIAR_ESTA_CLAVE
MYSQL_PORT=3307

# JWT: use una cadena larga, privada y diferente en producción.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRATION=86400000

FRONTEND_PORT=8080

# Semillas académicas. Desactive demo-data en producción.
SEED_DEMO_DATA=true
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@globalisosecurity.com
SEED_ADMIN_PASSWORD=Admin123*

# Dentro de Docker se fuerza /app/storage/evidencias y se monta un volumen persistente.
# Para ejecución local directa puede usar una ruta absoluta o relativa:
EVIDENCE_STORAGE_PATH=./storage/evidencias

# RPM + Machine Learning experimental (mismo valor para backend y microservicio ML).
RPM_ML_ENABLED=true
RPM_ML_URL=http://ml-service:8002
RPM_ML_API_KEY=CAMBIAR_POR_UNA_CLAVE_PRIVADA_PARA_ML
RPM_ML_TIMEOUT_SECONDS=120
ML_API_KEY=CAMBIAR_POR_LA_MISMA_CLAVE_PRIVADA_PARA_ML
